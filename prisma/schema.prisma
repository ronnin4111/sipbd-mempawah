generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FishFarm {
  id              String   @id @default(cuid())
  year            Int
  kecamatan       String
  desa            String
  fishType        String
  containerType   String
  businessType    String
  productionQty   Float
  rtpCount        Int
  farmerCount     Int
  groupCount      Int
  targetQty       Float
  productionValue Float
  latitude        Float
  longitude       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
