generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FishFarm {
  id              String   @id @default(cuid())
  farmerId        String   @default("")
  year            Int
  triwulan        String   @default("Q4")
  kecamatan       String
  desa            String
  fishType        String
  containerType   String
  businessType    String
  farmerName      String   @default("")
  groupName       String   @default("")
  productionQty   Float
  rtpCount        Int
  farmerCount     Int
  groupCount      Int
  targetQty       Float
  productionValue Float
  latitude        Float
  longitude       Float
  kusuka          String   @default("")
  cpib            Boolean  @default(false)
  cbib            Boolean  @default(false)
  disaggregationBatchId String?
  disaggregationBatch   DisaggregationBatch? @relation(fields: [disaggregationBatchId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DisaggregationBatch {
  id              String   @id @default(cuid())
  year            Int
  triwulan        String
  kecamatan       String
  fishType        String
  containerType   String
  businessType    String
  totalQty        Float
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fishFarms       FishFarm[]
}

model CommodityPrice {
  id            String @id @default(cuid())
  fishType      String
  containerType String
  price         Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fishType, containerType])
}

model AppSetting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}

model ChatMemory {
  id          String    @id @default(cuid())
  sessionId   String    @default("default")
  category    String    @default("fact")    // fact | preference | correction | faq | insight
  key         String    // topic/subject identifier (e.g., "preferred_kecamatan", "kelompok_Gemura_status")
  value       String    // the memory content
  context     String    @default("")        // original conversation context for the memory
  confidence  Float     @default(1.0)       // 0.0-1.0, how confident we are about this memory
  source      String    @default("user_told") // user_told | ai_inferred | correction | system
  accessCount Int       @default(0)         // how many times this memory was used
  lastAccessedAt DateTime? @default(now())
  expiresAt   DateTime?                     // optional TTL — memories can decay
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sessionId, category])
  @@index([sessionId, key])
  @@index([expiresAt])
}

model KusukaRegistration {
  id              String   @id @default(cuid())
  nama            String   // NAMA - person's name
  provinsi        String   @default("KALIMANTAN BARAT")
  kabKota         String   @default("MEMPAWAH")
  kecamatan       String   // KECAMATAN
  kelDesa         String   // KEL/DESA
  noKusuka        String   @default("") // NO KUSUKA (16-digit)
  namaKelompok    String   @default("") // Nama Kelompok (can be empty)
  bentukUsaha     String   @default("Perseorangan") // BENTUK USAHA: Perseorangan | Kelompok Masyarakat | Badan Usaha
  profesiUtama    String   @default("Subsektor Pembudidaya Ikan") // PROFESI UTAMA
  alamat          String   @default("") // ALAMAT
  tglDibuat       DateTime @default(now()) // TANGGAL DI BUAT
  dibuatOleh      String   @default("") // DIBUAT OLEH
  tglDiperbaharui DateTime @default(now()) // TGL DIPERBAHARUI
  diperbaharuiOleh String  @default("") // DIPERBAHARUI OLEH
  divalidasiOleh  String   @default("") // DIVALIDASI OLEH
  tglDivalidasi   DateTime? // TGL DIVALIDASI
  statusKusuka    String   @default("Valid") // STATUS KUSUKA: Valid | Draf | Submit | -
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kecamatan])
  @@index([kelDesa])
  @@index([namaKelompok])
  @@index([noKusuka])
  @@index([statusKusuka])
  @@index([profesiUtama])
}

model KnowledgeDocument {
  id            String   @id @default(cuid())
  title         String   // Display name / filename
  fileType      String   // xlsx | docx | txt | csv | pdf
  fileSize      Int      @default(0)  // bytes
  description   String   @default("") // Optional user description
  category      String   @default("umum") // kusuka | kebijakan | laporan | catatan | umum
  contentHash   String   @default("") // SHA256 hash to detect duplicates
  totalChunks   Int      @default(0)
  isActive      Boolean  @default(true)
  uploadedBy    String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chunks        KnowledgeChunk[]

  @@index([category])
  @@index([isActive])
  @@index([contentHash])
}

model KnowledgeChunk {
  id           String            @id @default(cuid())
  documentId   String
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex   Int               // Order within the document
  content      String            // The actual text content of this chunk
  source       String            @default("") // Source reference (sheet name, page, etc.)
  keywords     String            @default("") // Extracted keywords for search (comma-separated)
  accessCount  Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([documentId])
  @@index([chunkIndex])
  @@index([keywords])
}

model Penyuluh {
  id              String   @id @default(cuid())
  nama            String
  nip             String   @default("")
  pangkatGolRuang String   @default("")
  jabatan         String   @default("")
  fotoUrl         String   @default("")
  noWa            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nama])
}

model Pegawai {
  id              String   @id @default(cuid())
  nama            String
  nip             String   @default("")
  pangkatGolRuang String   @default("")
  jabatan         String   @default("")
  fotoUrl         String   @default("")
  noWa            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nama])
}

model SocialMediaPost {
  id            String   @id @default(cuid())
  platform      String   // instagram | facebook | youtube | tiktok | twitter
  postUrl       String   // Full URL to the original post
  embedUrl      String   @default("") // Embed URL for iframe (e.g., instagram.com/p/{short}/embed/)
  caption       String   @default("") // Caption or description of the post
  thumbnailUrl  String   @default("") // Optional thumbnail image URL
  isPinned      Boolean  @default(false) // Pinned posts show first
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  addedBy       String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([isActive])
  @@index([sortOrder])
}
