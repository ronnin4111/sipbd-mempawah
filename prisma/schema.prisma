generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FishFarm {
  id              String   @id @default(cuid())
  farmerId        String   @default("")
  year            Int
  triwulan        String   @default("Q4")
  kecamatan       String
  desa            String
  fishType        String
  containerType   String
  businessType    String
  farmerName      String   @default("")
  groupName       String   @default("")
  productionQty   Float
  rtpCount        Int
  farmerCount     Int
  groupCount      Int
  targetQty       Float
  productionValue Float
  latitude        Float
  longitude       Float
  kusuka          String   @default("")
  cpib            Boolean  @default(false)
  cbib            Boolean  @default(false)
  disaggregationBatchId String?
  disaggregationBatch   DisaggregationBatch? @relation(fields: [disaggregationBatchId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DisaggregationBatch {
  id              String   @id @default(cuid())
  year            Int
  triwulan        String
  kecamatan       String
  fishType        String
  containerType   String
  businessType    String
  totalQty        Float
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fishFarms       FishFarm[]
}

model CommodityPrice {
  id            String @id @default(cuid())
  fishType      String
  containerType String
  price         Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fishType, containerType])
}
