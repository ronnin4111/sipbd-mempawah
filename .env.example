# ============================================
# SIPBD Mempawah - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control!

# ---- Database (Turso / LibSQL) ----
# For Turso cloud database
TURSO_DATABASE_URL=libsql://your-db-name-your-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# For local development (SQLite file)
DATABASE_URL=file:./db/custom.db

# ---- Admin & Export Passwords ----
# Password for admin features (import, disagregasi, etc.)
ADMIN_PASSWORD=your-admin-password-here

# Separate password for Excel/PDF export
EXPORT_PASSWORD=your-export-password-here

# ---- AI API Keys ----
# Google Gemini API (for AI chat features)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API (alternative AI provider)
GROQ_API_KEY=your-groq-api-key-here

# Hugging Face API (alternative AI provider)
HF_API_KEY=your-hf-api-key-here

# ---- Z.AI Configuration (PRIMARY AI Provider) ----
# IMPORTANT: Set these for Vercel/production deployment!
# In sandbox/dev, Z.AI works automatically via .z-ai-config file.
# On Vercel, you MUST set ZAI_BASE_URL and ZAI_API_KEY.
#
# IMPORTANT: Do NOT use https://chat.z.ai/api/v1 — that's the web frontend, not the API!
# The correct API base URL is: https://api.z.ai/api/v1
#
# You need a Z.AI API key. Get one from: https://chat.z.ai → Settings → API Keys
# Or use Gemini/Groq free tier as fallback (see below).
ZAI_BASE_URL=https://api.z.ai/api/v1
ZAI_API_KEY=your-zai-api-key-here
# Optional (for authenticated access with session token):
# ZAI_CHAT_ID=chat-xxxx
# ZAI_USER_ID=xxxx
# ZAI_TOKEN=jwt-token-here

# ---- ZAI Proxy (internal - sandbox only) ----
# Base URL for internal ZAI API proxy (only needed in sandbox/dev environment)
ZAI_API_BASE_URL=http://localhost:8080

# ---- Next.js ----
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
