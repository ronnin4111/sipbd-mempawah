# ============================================
# SIPBD Mempawah - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control!

# ---- Database (Turso / LibSQL) ----
# For Turso cloud database
TURSO_DATABASE_URL=libsql://your-db-name-your-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# For local development (SQLite file)
DATABASE_URL=file:./db/custom.db

# ---- Admin & Export Passwords ----
# Password for admin features (import, disagregasi, etc.)
ADMIN_PASSWORD=your-admin-password-here

# Separate password for Excel/PDF export
EXPORT_PASSWORD=your-export-password-here

# ---- AI API Keys ----
# Google Gemini API (for AI chat features)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API (alternative AI provider)
GROQ_API_KEY=your-groq-api-key-here

# Hugging Face API (alternative AI provider)
HF_API_KEY=your-hf-api-key-here

# ---- ZAI Proxy (internal) ----
# Base URL for internal ZAI API proxy (only needed in sandbox/dev environment)
ZAI_API_BASE_URL=http://localhost:8080

# ---- Next.js ----
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
