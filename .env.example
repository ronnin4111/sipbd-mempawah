# Local Development (SQLite)
DATABASE_URL=file:./db/custom.db

# Production / Vercel (Turso - auto-detected)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# The app auto-detects Turso when:
# - VERCEL env var is set (Vercel deployment), OR
# - NODE_ENV=production AND Turso credentials exist, OR
# - USE_TURSO=true is explicitly set
